# Copier vers .env.local. Seule la clé anon est publique.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Développement uniquement : connexion automatique sans e-mail (compte créé à la main dans Supabase).
